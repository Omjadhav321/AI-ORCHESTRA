# AI-ORCHESTRA — InfinityFree configuration
# Upload the CONTENTS of this folder (including this file) into htdocs.

# Pretty entry points: /userside/ /govoffice/ /hospitalside/
DirectoryIndex index.html index.php

# Custom 404
ErrorDocument 404 /404.html

# --- Pretty URLs -------------------------------------------------------
# The three portals are reachable as /userside/ etc. even without the
# rewrite rules below. The rules additionally allow extensionless URLs.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # /userside -> /userside/
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/ [R=301,L]

  # /userside/index.html -> /userside/  (one canonical URL per portal)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/index\.html$ $1/ [R=301,L]
</IfModule>

# --- Correct MIME types -------------------------------------------------
<IfModule mod_mime.c>
  AddType text/css                .css
  AddType application/javascript  .js
  AddType image/svg+xml           .svg
  AddType image/webp              .webp
  AddCharset UTF-8                .html .css .js .svg
</IfModule>

# --- Caching ------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                 "access plus 0 seconds"
  ExpiresByType text/css                  "access plus 604800"
  ExpiresByType application/javascript    "access plus 604800"
  ExpiresByType image/jpeg                "access plus 2592000"
  ExpiresByType image/png                 "access plus 2592000"
  ExpiresByType image/svg+xml             "access plus 2592000"
  ExpiresByType image/webp                "access plus 2592000"
</IfModule>

# --- Compression --------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# --- Hardening ----------------------------------------------------------
# Wrapped in IfModule so an unsupported directive can never 500 the site.
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>
<IfModule mod_headers.c>
  Header unset X-Powered-By
</IfModule>

# Never serve docs/config leftovers if any are added later
<FilesMatch "\.(?:md|log|ini|sql|bak|dist|example)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
